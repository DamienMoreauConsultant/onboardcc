# Backend — variables d'environnement
# Copier ce fichier en .env et remplir les valeurs.
# Ne jamais committer le fichier .env en version control.

# Chaîne de connexion PostgreSQL (fournie automatiquement par Replit)
DATABASE_URL=postgresql://user:password@localhost:5432/onboardcc

# Clé secrète pour signer les JWT — doit faire au moins 32 caractères (OWASP)
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=changez_cette_valeur_32_caracteres_minimum_absolument

# Durée de validité du JWT en heures (8h par défaut)
JWT_EXPIRE_HOURS=8

# URL du frontend (pour la configuration CORS)
FRONTEND_URL=http://localhost:5173

# Configuration SMTP pour l'envoi d'emails (création de compte candidat, prompt 3)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@ladcc.org

# Espace partagé où les recruteurs déposent les pièces jointes avant d'enregistrer leur URL.
PIECE_JOINTE_STORAGE_URL=https://drive.google.com/drive/folders/XXXXXXXXXXXXXXXXXXXXXXXX?usp=sharing

# Barème du matching Opportunité. Ces valeurs sont configurables sans modifier le code.
MATCH_SCORE_REGION_P1=10
MATCH_SCORE_REGION_P2=10
MATCH_SCORE_REGION_P3=7
MATCH_SCORE_REGION_P4=7
MATCH_SCORE_REGION_P5=3
MATCH_SCORE_REGION_P6=3
MATCH_SCORE_REGION_NON=0
MATCH_SCORE_REGION_OUI=10
MATCH_SCORE_EXACT=10
MATCH_SCORE_ADJACENT=5
MATCH_SCORE_HOUSING_PARTNER=9
MATCH_SCORE_HOUSING_NEARBY=5
MATCH_SCORE_LANGUAGE_DIFFERENT_LEVEL=7
MATCH_SCORE_LANGUAGE_NEW=5
MATCH_SCORE_SKILLS_ALL=10
MATCH_SCORE_SKILLS_SOME=7
MATCH_SCORE_SKILLS_DOMAIN=5
MATCH_SCORE_WARNING_OK=0
MATCH_SCORE_WARNING_ATTENTION=5
MATCH_SCORE_WARNING_KO=10
MATCH_SCORE_DATE_EXACT=10
MATCH_SCORE_DATE_ONE_MONTH=9
MATCH_SCORE_DATE_THREE_MONTHS=5
MATCH_SCORE_DATE_SIX_MONTHS=2
MATCH_SCORE_DATE_OTHER=0
