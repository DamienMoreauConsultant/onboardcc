# Backend — variables d'environnement
# Copier ce fichier en .env et remplir les valeurs.
# Ne jamais committer le fichier .env en version control.

# Chaîne de connexion PostgreSQL (fournie automatiquement par Replit)
DATABASE_URL=postgresql://user:password@localhost:5432/onboardcc

# Clé secrète pour signer les JWT — doit faire au moins 32 caractères (OWASP)
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=changez_cette_valeur_32_caracteres_minimum_absolument

# Durée de validité du JWT en heures (8h par défaut)
JWT_EXPIRE_HOURS=8

# URL du frontend (pour la configuration CORS)
FRONTEND_URL=http://localhost:5173

# Configuration SMTP pour l'envoi d'emails (création de compte candidat, prompt 3)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@ladcc.org
